APP_ENV=development
APP_NAME=EstateFlow AI
DATABASE_URL=
DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Authentication / JWT (JWT_SECRET_KEY is required in all environments)
JWT_SECRET_KEY=
# Dedicated key (base64url, 32 bytes) for idempotent refresh-token recovery; empty disables it.
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
REFRESH_RECOVERY_KEY=
REFRESH_RECOVERY_GRACE_SECONDS=20
JWT_ALGORITHM=HS256
JWT_ISSUER=estateflow-ai
JWT_AUDIENCE=estateflow-ai-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie (set COOKIE_SECURE=false only for local http:// development)
REFRESH_COOKIE_NAME=estateflow_refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Login rate limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Admin bootstrap (used only by `python -m backend.cli.bootstrap_admin`)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=


# Customer transactional email (Feature 14). EMAIL_PROVIDER=log never sends real email.
# For production set EMAIL_PROVIDER=resend plus the secrets below (deployment secret manager only).
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EstateFlow
EMAIL_REPLY_TO=
EMAIL_SUPPORT_CONTACT=
CUSTOMER_PORTAL_BASE_URL=
CUSTOMER_EMAIL_WORKER_POLL_SECONDS=5
CUSTOMER_EMAIL_MAX_ATTEMPTS=5

# AI (Groq) and retrieval
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Public URLs (used in emails and chat links) and inbound-enquiry webhook secrets ("source:secret,source:secret")
FRONTEND_BASE_URL=http://localhost:3000
WEBHOOK_SOURCE_SECRETS=

# Demo accounts created by `python -m backend.cli.seed_demo` (optional, defaults shown in deployment.md)
DEMO_PASSWORD=
