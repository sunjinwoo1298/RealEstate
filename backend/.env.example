APP_ENV=development
APP_NAME=EstateFlow AI
DATABASE_URL=
DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Authentication / JWT (JWT_SECRET_KEY is required in all environments)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=estateflow-ai
JWT_AUDIENCE=estateflow-ai-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie (set COOKIE_SECURE=false only for local http:// development)
REFRESH_COOKIE_NAME=estateflow_refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Login rate limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Admin bootstrap (used only by `python -m backend.cli.bootstrap_admin`)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

